# Copy this file to .env and fill in real values for local runs.
# In GitHub Actions, set these as repository Secrets instead (Settings > Secrets and variables > Actions).

# --- SMTP / Email ---
# Gmail example: use an App Password, not your normal password.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_TO=you@example.com,optional_second@example.com
